function(check_cli expected_exit expected_message)
    execute_process(COMMAND "${PROGRAM}" ${ARGN}
        RESULT_VARIABLE exit_code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
    if(NOT "${exit_code}" STREQUAL "${expected_exit}")
        message(FATAL_ERROR "Unexpected exit code for [${ARGN}]: ${exit_code}; ${stderr}")
    endif()
    if(NOT stdout STREQUAL "")
        message(FATAL_ERROR "CLI polluted the protocol stdout: ${stdout}")
    endif()
    if(NOT stderr MATCHES "${expected_message}")
        message(FATAL_ERROR "Missing diagnostic for [${ARGN}]: ${stderr}")
    endif()
endfunction()

check_cli(0 "Self-check passed" --self-check)
check_cli(0 "Usage:" --help)
check_cli(0 "structural-mcp [0-9]+\\.[0-9]+\\.[0-9]+" --version)
check_cli(2 "not implemented")
check_cli(2 "Unknown option" --not-an-option)
check_cli(2 "not implemented" --self-check unexpected)
