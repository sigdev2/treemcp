{
  "name": "batch_search",
  "description": "Run structural queries over one shared workspace scope, with matches sorted by path and byte range.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "queries": {
        "type": "array",
        "description": "Use unique IDs and at most 262144 UTF-8 bytes of query text across all items.",
        "items": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 128, "x-maxUtf8Bytes": 128},
            "language": {"type": "string", "minLength": 0, "maxLength": 64, "x-maxUtf8Bytes": 64},
            "query": {"type": "string", "minLength": 0, "maxLength": 65536, "x-maxUtf8Bytes": 65536},
            "maxMatches": {"type": "integer", "minimum": 1, "maximum": 200, "default": 100}
          },
          "required": ["id", "language", "query"],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 16
      },
      "paths": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {"type": "string", "minLength": 1, "maxLength": 4096, "x-maxUtf8Bytes": 4096}
      },
      "include": {
        "type": "array",
        "maxItems": 64,
        "items": {"type": "string", "minLength": 1, "maxLength": 512, "x-maxUtf8Bytes": 512}
      },
      "exclude": {
        "type": "array",
        "maxItems": 64,
        "items": {"type": "string", "minLength": 1, "maxLength": 512, "x-maxUtf8Bytes": 512}
      },
      "sort": {"type": "string", "enum": ["path"], "default": "path"},
      "maxFiles": {"type": "integer", "minimum": 1, "maximum": 10000, "default": 10000},
      "maxTotalMatches": {"type": "integer", "minimum": 1, "maximum": 200, "default": 200},
      "maxResponseBytes": {"type": "integer", "minimum": 131072, "maximum": 8388608, "default": 8388608},
      "deadlineMs": {"type": "integer", "minimum": 1, "maximum": 300000, "default": 30000}
    },
    "required": ["queries", "paths"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 128, "x-maxUtf8Bytes": 128},
            "matches": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object",
                "properties": {
                  "path": {"type": "string"},
                  "patternIndex": {"type": "integer", "minimum": 0},
                  "captures": {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {"type": "string"},
                        "range": {
                          "type": "object",
                          "properties": {
                            "startByte": {"type": "integer", "minimum": 0},
                            "endByte": {"type": "integer", "minimum": 0},
                            "startRow": {"type": "integer", "minimum": 0},
                            "startColumn": {"type": "integer", "minimum": 0},
                            "endRow": {"type": "integer", "minimum": 0},
                            "endColumn": {"type": "integer", "minimum": 0}
                          },
                          "required": ["startByte", "endByte", "startRow", "startColumn", "endRow", "endColumn"],
                          "additionalProperties": false
                        },
                        "text": {"type": "string", "maxLength": 1024, "x-maxUtf8Bytes": 1024},
                        "textTruncated": {"type": "boolean"}
                      },
                      "required": ["name", "range", "text", "textTruncated"],
                      "additionalProperties": false
                    }
                  },
                  "capturesTruncated": {"type": "boolean"}
                },
                "required": ["path", "patternIndex", "captures", "capturesTruncated"],
                "additionalProperties": false
              }
            },
            "hasSyntaxErrors": {"type": "boolean"},
            "truncated": {"type": "boolean"},
            "incomplete": {"type": "boolean"},
            "error": {
              "type": "object",
              "properties": {"message": {"type": "string"}, "byteOffset": {"type": "integer", "minimum": 0}},
              "required": ["message"],
              "additionalProperties": false
            }
          },
          "required": ["id", "matches", "hasSyntaxErrors", "truncated", "incomplete"],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 16
      },
      "stats": {
        "type": "object",
        "properties": {
          "filesVisited": {"type": "integer", "minimum": 0},
          "filesRead": {"type": "integer", "minimum": 0},
          "filesParsed": {"type": "integer", "minimum": 0},
          "treeBuilds": {"type": "integer", "minimum": 0},
          "queryExecutions": {"type": "integer", "minimum": 0}
        },
        "required": ["filesVisited", "filesRead", "filesParsed", "treeBuilds", "queryExecutions"],
        "additionalProperties": false
      },
      "diagnostics": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "properties": {"path": {"type": "string"}, "message": {"type": "string"}},
          "required": ["path", "message"],
          "additionalProperties": false
        }
      },
      "truncated": {"type": "boolean"},
      "deadlineExceeded": {"type": "boolean"},
      "incomplete": {"type": "boolean"}
    },
    "required": ["items", "stats", "diagnostics", "truncated", "incomplete", "deadlineExceeded"],
    "additionalProperties": false
  }
}
