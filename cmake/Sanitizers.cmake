option(TREEMCP_ENABLE_SANITIZERS "Enable AddressSanitizer and UndefinedBehaviorSanitizer" OFF)
option(TREEMCP_ENABLE_TSAN "Enable the Linux ThreadSanitizer build" OFF)
option(TREEMCP_ENABLE_FUZZING "Build bounded libFuzzer targets" OFF)

if(TREEMCP_ENABLE_TSAN OR TREEMCP_ENABLE_SANITIZERS)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        message(FATAL_ERROR "Sanitizers currently require GCC or Clang on Linux (including WSL).")
    endif()
    if(TREEMCP_ENABLE_TSAN AND TREEMCP_ENABLE_SANITIZERS)
        message(FATAL_ERROR "Configure TSan and ASan/UBSan in separate builds.")
    elseif(TREEMCP_ENABLE_TSAN)
        set(sanitizers thread)
    else()
        set(sanitizers address,undefined)
    endif()
    add_compile_options(-fsanitize=${sanitizers} -fno-omit-frame-pointer)
    add_link_options(-fsanitize=${sanitizers})
endif()

if(TREEMCP_ENABLE_FUZZING)
    if(NOT TREEMCP_ENABLE_SANITIZERS OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang"
        OR NOT CMAKE_C_COMPILER_ID STREQUAL "Clang")
        message(FATAL_ERROR "Use the linux-fuzz preset with Clang and ASan/UBSan.")
    endif()
    add_compile_options(-fsanitize=fuzzer-no-link)
endif()
