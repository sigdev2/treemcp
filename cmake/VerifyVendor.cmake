set(vendor_root "${PROJECT_SOURCE_DIR}/third_party")
file(GLOB_RECURSE unverified_files LIST_DIRECTORIES false RELATIVE "${vendor_root}" "${vendor_root}/*")
list(REMOVE_ITEM unverified_files SHA256SUMS)
file(STRINGS "${vendor_root}/SHA256SUMS" vendor_hashes)
foreach(entry IN LISTS vendor_hashes)
    string(SUBSTRING "${entry}" 0 64 expected_hash)
    string(SUBSTRING "${entry}" 66 -1 relative_path)
    list(FIND unverified_files "${relative_path}" index)
    if(index EQUAL -1)
        message(FATAL_ERROR "Missing or duplicate vendored file in SHA256SUMS: ${relative_path}")
    endif()
    list(REMOVE_AT unverified_files ${index})
    file(SHA256 "${vendor_root}/${relative_path}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
        message(FATAL_ERROR "Vendored source checksum mismatch: ${relative_path}")
    endif()
endforeach()
if(NOT "${unverified_files}" STREQUAL "")
    list(JOIN unverified_files ", " missing_hashes)
    message(FATAL_ERROR "Vendored files missing from SHA256SUMS: ${missing_hashes}")
endif()
