file(STRINGS "${PROJECT_SOURCE_DIR}/third_party/SHA256SUMS" vendor_hashes)
foreach(entry IN LISTS vendor_hashes)
    string(SUBSTRING "${entry}" 0 64 expected_hash)
    string(SUBSTRING "${entry}" 66 -1 relative_path)
    set(source_path "${PROJECT_SOURCE_DIR}/third_party/${relative_path}")
    if(NOT EXISTS "${source_path}")
        message(FATAL_ERROR "Missing vendored source: ${relative_path}")
    endif()
    file(SHA256 "${source_path}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
        message(FATAL_ERROR "Vendored source checksum mismatch: ${relative_path}")
    endif()
endforeach()
